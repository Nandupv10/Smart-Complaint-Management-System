
import { useEffect, useMemo, useState } from "react";
import "./App.css";

const API_BASE = (
  import.meta.env.VITE_API_BASE_URL || "http://localhost:3000"
).replace(/\/$/, "");

const CATEGORY_OPTIONS = [
  "Infrastructure",
  "Hostel",
  "Maintenance",
  "Cleanliness",
  "IT Support",
  "Academics",
  "Other",
];

async function apiRequest(path, { token, ...options } = {}) {
  const response = await fetch(`${API_BASE}${path}`, {
    ...options,
    headers: {
      ...(options.body ? { "Content-Type": "application/json" } : {}),
      ...(token ? { Authorization: `Bearer ${token}` } : {}),
      ...options.headers,
    },
  });

  const data = await response.json().catch(() => ({}));

  if (!response.ok) {
    throw new Error(
      data.message || data.error || `Request failed (${response.status})`
    );
  }

  return data;
}

function getComplaints(data) {
  if (Array.isArray(data)) return data;
  if (Array.isArray(data.complaints)) return data.complaints;
  if (Array.isArray(data.data)) return data.data;
  return [];
}

function complaintId(item) {
  return item.complaintId ?? item.complaint_id ?? item.id ?? "—";
}

function complaintTitle(item) {
  return item.title ?? item.subject ?? "Untitled complaint";
}

function complaintDescription(item) {
  return item.description ?? item.details ?? "";
}

function complaintStatus(item) {
  return item.status ?? "Submitted";
}

function complaintCategory(item) {
  return item.category ?? "Uncategorized";
}

function displayDate(value) {
  if (!value) return "—";
  const date = new Date(value);
  return Number.isNaN(date.getTime())
    ? String(value)
    : date.toLocaleDateString(undefined, {
        day: "2-digit",
        month: "short",
        year: "numeric",
      });
}

function initials(user) {
  const name = user?.name || user?.email || "User";
  return name.slice(0, 2).toUpperCase();
}

function StatusBadge({ status }) {
  const normalized = String(status).toLowerCase().replaceAll(" ", "-");
  return (
    <span className={`status-badge status-${normalized}`}>
      <span className="status-dot" />
      {status}
    </span>
  );
}

function ThemeButton({ theme, onClick }) {
  return (
    <button
      className="icon-button"
      type="button"
      onClick={onClick}
      title={`Switch to ${theme === "light" ? "dark" : "light"} mode`}
      aria-label="Toggle color theme"
    >
      {theme === "light" ? "☾" : "☀"}
    </button>
  );
}

export default function App() {
  const [theme, setTheme] = useState(
    () => localStorage.getItem("scms-theme") || "light"
  );
  const [token, setToken] = useState(
    () => localStorage.getItem("scms-token") || ""
  );
  const [user, setUser] = useState(() => {
    try {
      return JSON.parse(localStorage.getItem("scms-user") || "null");
    } catch {
      return null;
    }
  });

  const [authMode, setAuthMode] = useState("login");
  const [activePage, setActivePage] = useState("dashboard");
  const [complaints, setComplaints] = useState([]);
  const [loading, setLoading] = useState(false);
  const [submitting, setSubmitting] = useState(false);
  const [notice, setNotice] = useState(null);
  const [search, setSearch] = useState("");
  const [statusFilter, setStatusFilter] = useState("all");
  const [categoryFilter, setCategoryFilter] = useState("all");

  const [authForm, setAuthForm] = useState({ email: "", password: "" });
  const [complaintForm, setComplaintForm] = useState({
    title: "",
    description: "",
  });

  const isAdmin = user?.role === "admin";

  useEffect(() => {
    document.documentElement.dataset.theme = theme;
    localStorage.setItem("scms-theme", theme);
  }, [theme]);

  useEffect(() => {
    if (token) loadComplaints();
    // loadComplaints uses the current session token.
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [token]);

  async function loadComplaints() {
    setLoading(true);
    try {
      const data = await apiRequest("/complaints", { token });
      setComplaints(getComplaints(data));
    } catch (error) {
      setNotice({ type: "error", text: error.message });
    } finally {
      setLoading(false);
    }
  }

  function saveSession(data) {
    const newToken = data.token || data.accessToken;
    const newUser = data.user || data.account;

    if (!newToken) {
      throw new Error("The API did not return a token. Check the login response.");
    }

    const sessionUser = newUser || {
      email: authForm.email,
      role: "user",
    };

    localStorage.setItem("scms-token", newToken);
    localStorage.setItem("scms-user", JSON.stringify(sessionUser));
    setToken(newToken);
    setUser(sessionUser);
    setActivePage("dashboard");
    setNotice({ type: "success", text: "You're signed in successfully." });
  }

  async function handleAuth(event) {
    event.preventDefault();
    setNotice(null);

    if (!authForm.email.trim() || !authForm.password) {
      setNotice({ type: "error", text: "Enter your email and password." });
      return;
    }

    try {
      setSubmitting(true);
      const path =
        authMode === "login" ? "/auth/login" : "/auth/register";
      const data = await apiRequest(path, {
        method: "POST",
        body: JSON.stringify({
          email: authForm.email.trim(),
          password: authForm.password,
        }),
      });

      if (authMode === "register" && !(data.token || data.accessToken)) {
        setAuthMode("login");
        setNotice({
          type: "success",
          text: "Account created. Sign in with your new credentials.",
        });
        setAuthForm((current) => ({ ...current, password: "" }));
        return;
      }

      saveSession(data);
    } catch (error) {
      setNotice({ type: "error", text: error.message });
    } finally {
      setSubmitting(false);
    }
  }

  function logout() {
    localStorage.removeItem("scms-token");
    localStorage.removeItem("scms-user");
    setToken("");
    setUser(null);
    setComplaints([]);
    setNotice(null);
    setAuthForm({ email: "", password: "" });
    setActivePage("dashboard");
  }

  async function handleComplaintSubmit(event) {
    event.preventDefault();
    setNotice(null);

    const title = complaintForm.title.trim();
    const description = complaintForm.description.trim();

    if (!title || !description) {
      setNotice({
        type: "error",
        text: "Please provide both a title and a description.",
      });
      return;
    }

    if (title.length > 100) {
      setNotice({
        type: "error",
        text: "The title must be 100 characters or fewer.",
      });
      return;
    }

    try {
      setSubmitting(true);
      const result = await apiRequest("/complaints", {
        method: "POST",
        token,
        body: JSON.stringify({ title, description }),
      });

      setComplaintForm({ title: "", description: "" });
      setNotice({
        type: "success",
        text: `Complaint submitted successfully${
          result.complaintId || result.complaint?.complaintId
            ? ` — ID ${result.complaintId || result.complaint.complaintId}`
            : ""
        }.`,
      });
      setActivePage("complaints");
      await loadComplaints();
    } catch (error) {
      setNotice({ type: "error", text: error.message });
    } finally {
      setSubmitting(false);
    }
  }

  async function updateCategory(item, category) {
    if (!category || category === complaintCategory(item)) return;

    try {
      setNotice(null);
      await apiRequest(
        `/complaints/${encodeURIComponent(complaintId(item))}/category`,
        {
          method: "PATCH",
          token,
          body: JSON.stringify({ category }),
        }
      );
      setNotice({ type: "success", text: "Complaint category updated." });
      await loadComplaints();
    } catch (error) {
      setNotice({ type: "error", text: error.message });
    }
  }

  const filteredComplaints = useMemo(() => {
    return complaints.filter((item) => {
      const query = search.toLowerCase();
      const matchesSearch = [
        complaintId(item),
        complaintTitle(item),
        complaintDescription(item),
        complaintCategory(item),
        item.email,
      ]
        .filter(Boolean)
        .some((value) => String(value).toLowerCase().includes(query));

      const matchesStatus =
        statusFilter === "all" ||
        complaintStatus(item).toLowerCase() === statusFilter.toLowerCase();

      const matchesCategory =
        categoryFilter === "all" ||
        complaintCategory(item).toLowerCase() === categoryFilter.toLowerCase();

      return matchesSearch && matchesStatus && matchesCategory;
    });
  }, [complaints, search, statusFilter, categoryFilter]);

  const stats = useMemo(() => {
    const open = complaints.filter((item) =>
      !["resolved", "closed", "completed"].includes(
        complaintStatus(item).toLowerCase()
      )
    ).length;

    const resolved = complaints.filter((item) =>
      ["resolved", "closed", "completed"].includes(
        complaintStatus(item).toLowerCase()
      )
    ).length;

    return {
      total: complaints.length,
      open,
      resolved,
    };
  }, [complaints]);

  if (!token) {
    return (
      <main className="auth-layout">
        <section className="auth-brand-panel">
          <div className="brand-lockup">
            <span className="brand-mark">S</span>
            <span>Campus<span className="brand-light">Care</span></span>
          </div>
          <div className="auth-hero">
            <span className="eyebrow">SMART COMPLAINT MANAGEMENT</span>
            <h1>A better campus starts with being heard.</h1>
            <p>
              Raise concerns, track progress, and help make your campus a
              better place for everyone.
            </p>
            <div className="hero-stat-row">
              <div><strong>One place</strong><span>for every concern</span></div>
              <div><strong>Clear updates</strong><span>at every step</span></div>
            </div>
          </div>
          <div className="auth-footer">A simpler way to make a difference.</div>
        </section>

        <section className="auth-form-panel">
          <div className="auth-topbar">
            <span className="mobile-brand">CampusCare</span>
            <ThemeButton
              theme={theme}
              onClick={() => setTheme(theme === "light" ? "dark" : "light")}
            />
          </div>
          <div className="auth-card">
            <span className="eyebrow">
              {authMode === "login" ? "WELCOME BACK" : "GET STARTED"}
            </span>
            <h2>{authMode === "login" ? "Sign in to your account" : "Create your account"}</h2>
            <p className="muted">
              {authMode === "login"
                ? "Enter your details to access your complaint dashboard."
                : "Create an account to submit and track complaints."}
            </p>

            {notice && (
              <div className={`notice notice-${notice.type}`} role="status">
                {notice.text}
              </div>
            )}

            <form onSubmit={handleAuth} className="form-stack">
              <label>
                Email address
                <input
                  type="email"
                  autoComplete="email"
                  placeholder="you@university.edu"
                  value={authForm.email}
                  onChange={(event) =>
                    setAuthForm({ ...authForm, email: event.target.value })
                  }
                  required
                />
              </label>
              <label>
                Password
                <input
                  type="password"
                  autoComplete={
                    authMode === "login" ? "current-password" : "new-password"
                  }
                  placeholder="At least 12 characters"
                  minLength={12}
                  value={authForm.password}
                  onChange={(event) =>
                    setAuthForm({ ...authForm, password: event.target.value })
                  }
                  required
                />
              </label>
              <button className="primary-button full-button" disabled={submitting}>
                {submitting
                  ? "Please wait…"
                  : authMode === "login"
                    ? "Sign in →"
                    : "Create account →"}
              </button>
            </form>

            <p className="auth-switch">
              {authMode === "login" ? "New to CampusCare?" : "Already have an account?"}{" "}
              <button
                type="button"
                className="text-button"
                onClick={() => {
                  setAuthMode(authMode === "login" ? "register" : "login");
                  setNotice(null);
                }}
              >
                {authMode === "login" ? "Create an account" : "Sign in"}
              </button>
            </p>
            <p className="auth-disclaimer">
              Your account is protected by secure authentication.
            </p>
          </div>
        </section>
      </main>
    );
  }

  return (
    <div className="app-shell">
      <aside className="sidebar">
        <div className="brand-lockup sidebar-brand">
          <span className="brand-mark">S</span>
          <span>Campus<span className="brand-light">Care</span></span>
        </div>

        <div className="workspace-label">WORKSPACE</div>
        <nav className="side-nav" aria-label="Main navigation">
          <button
            className={activePage === "dashboard" ? "nav-item active" : "nav-item"}
            onClick={() => setActivePage("dashboard")}
          >
            <span className="nav-icon">⌂</span> Overview
          </button>
          <button
            className={activePage === "complaints" ? "nav-item active" : "nav-item"}
            onClick={() => setActivePage("complaints")}
          >
            <span className="nav-icon">▤</span> {isAdmin ? "All complaints" : "My complaints"}
            <span className="nav-count">{complaints.length}</span>
          </button>
          {!isAdmin && (
            <button
              className={activePage === "new" ? "nav-item active" : "nav-item"}
              onClick={() => setActivePage("new")}
            >
              <span className="nav-icon">＋</span> Submit a complaint
            </button>
          )}
        </nav>

        <div className="sidebar-bottom">
          <div className="help-card">
            <span className="help-icon">✦</span>
            <strong>Need assistance?</strong>
            <p>Use the complaint form to let the campus team know.</p>
            {!isAdmin && (
              <button onClick={() => setActivePage("new")} className="help-link">
                Submit a complaint →
              </button>
            )}
          </div>
          <div className="profile-row">
            <span className="avatar">{initials(user)}</span>
            <div className="profile-info">
              <strong>{user?.name || user?.email || "Signed-in user"}</strong>
              <span>{user?.role || "user"}</span>
            </div>
            <button className="logout-button" onClick={logout} title="Sign out" aria-label="Sign out">↪</button>
          </div>
        </div>
      </aside>

      <main className="main-panel">
        <header className="topbar">
          <div>
            <span className="breadcrumb">Workspace <span>/</span> {activePage === "new" ? "New complaint" : activePage === "complaints" ? "Complaints" : "Overview"}</span>
            <h1>
              {activePage === "new"
                ? "Submit a complaint"
                : activePage === "complaints"
                  ? isAdmin ? "All complaints" : "My complaints"
                  : "Overview"}
            </h1>
          </div>
          <div className="topbar-actions">
            <span className="connection-pill"><span /> CampusCare portal</span>
            <ThemeButton
              theme={theme}
              onClick={() => setTheme(theme === "light" ? "dark" : "light")}
            />
            {!isAdmin && (
              <button className="primary-button topbar-cta" onClick={() => setActivePage("new")}>
                <span>＋</span> New complaint
              </button>
            )}
          </div>
        </header>

        <div className="page-content">
          {notice && (
            <div className={`notice notice-${notice.type}`} role="status">
              <span>{notice.type === "success" ? "✓" : "!"}</span>
              {notice.text}
              <button onClick={() => setNotice(null)} aria-label="Dismiss message">×</button>
            </div>
          )}

          {activePage === "dashboard" && (
            <>
              <div className="welcome-row">
                <div>
                  <h2>Hello{user?.name ? `, ${user.name}` : ""} <span className="wave">✦</span></h2>
                  <p className="muted">
                    {isAdmin
                      ? "Here is the latest complaint activity across your campus."
                      : "Here is an overview of your submitted complaints."}
                  </p>
                </div>
                <button className="secondary-button" onClick={loadComplaints} disabled={loading}>
                  ↻ Refresh
                </button>
              </div>

              <section className="stats-grid">
                <StatCard icon="▤" label="Total complaints" value={stats.total} tone="blue" detail="Complaints in your view" />
                <StatCard icon="◷" label="Open complaints" value={stats.open} tone="amber" detail="Awaiting resolution" />
                <StatCard icon="✓" label="Resolved complaints" value={stats.resolved} tone="green" detail="Marked as resolved" />
              </section>

              <section className="panel recent-panel">
                <div className="panel-heading">
                  <div>
                    <h3>Recent complaints</h3>
                    <p className="muted">A quick look at the latest submissions.</p>
                  </div>
                  <button className="text-button" onClick={() => setActivePage("complaints")}>
                    View all →
                  </button>
                </div>
                <ComplaintTable
                  items={[...complaints].slice(0, 5)}
                  isAdmin={isAdmin}
                  onCategoryChange={updateCategory}
                  loading={loading}
                  emptyText="No complaints yet. Your submissions will appear here."
                />
              </section>
              {!isAdmin && (
                <section className="callout">
                  <div className="callout-icon">✦</div>
                  <div>
                    <h3>Have something to report?</h3>
                    <p>Tell us what happened. Your complaint will be recorded so it can be tracked.</p>
                  </div>
                  <button className="primary-button" onClick={() => setActivePage("new")}>
                    Submit complaint →
                  </button>
                </section>
              )}
            </>
          )}

          {activePage === "complaints" && (
            <section className="panel">
              <div className="panel-heading">
                <div>
                  <h3>{isAdmin ? "Complaint directory" : "Complaint history"}</h3>
                  <p className="muted">
                    {filteredComplaints.length} of {complaints.length} complaints shown
                  </p>
                </div>
                <button className="secondary-button" onClick={loadComplaints} disabled={loading}>
                  ↻ Refresh
                </button>
              </div>

              <div className="filters">
                <label className="search-field">
                  <span>⌕</span>
                  <input
                    value={search}
                    onChange={(event) => setSearch(event.target.value)}
                    placeholder="Search complaints…"
                    aria-label="Search complaints"
                  />
                </label>
                <select value={statusFilter} onChange={(event) => setStatusFilter(event.target.value)} aria-label="Filter by status">
                  <option value="all">All statuses</option>
                  {[...new Set(complaints.map(complaintStatus))].map((status) => (
                    <option value={status} key={status}>{status}</option>
                  ))}
                </select>
                <select value={categoryFilter} onChange={(event) => setCategoryFilter(event.target.value)} aria-label="Filter by category">
                  <option value="all">All categories</option>
                  {[...new Set(complaints.map(complaintCategory))].map((category) => (
                    <option value={category} key={category}>{category}</option>
                  ))}
                </select>
              </div>

              <ComplaintTable
                items={filteredComplaints}
                isAdmin={isAdmin}
                onCategoryChange={updateCategory}
                loading={loading}
                emptyText="No matching complaints found."
              />
            </section>
          )}

          {activePage === "new" && (
            <section className="form-panel panel">
              <div className="form-panel-heading">
                <div className="form-symbol">＋</div>
                <div>
                  <h3>Tell us what happened</h3>
                  <p className="muted">Provide a clear title and description so your complaint can be understood.</p>
                </div>
              </div>
              <form onSubmit={handleComplaintSubmit} className="form-stack complaint-form">
                <label>
                  Complaint title <span className="required">*</span>
                  <input
                    maxLength={100}
                    value={complaintForm.title}
                    onChange={(event) => setComplaintForm({ ...complaintForm, title: event.target.value })}
                    placeholder="e.g. Water leakage in hostel bathroom"
                    required
                  />
                  <span className="field-hint">{complaintForm.title.length}/100 characters</span>
                </label>
                <label>
                  Description <span className="required">*</span>
                  <textarea
                    rows={7}
                    value={complaintForm.description}
                    onChange={(event) => setComplaintForm({ ...complaintForm, description: event.target.value })}
                    placeholder="Describe the issue, where it occurred, and any details that may help…"
                    required
                  />
                  <span className="field-hint">Avoid including passwords or other sensitive information.</span>
                </label>
                <div className="form-actions">
                  <button type="button" className="secondary-button" onClick={() => setActivePage("dashboard")}>
                    Cancel
                  </button>
                  <button className="primary-button" disabled={submitting}>
                    {submitting ? "Submitting…" : "Submit complaint →"}
                  </button>
                </div>
              </form>
              <div className="privacy-note"><span>ⓘ</span> Your complaint is submitted under your signed-in account.</div>
            </section>
          )}

          <footer className="page-footer">
            <span>© {new Date().getFullYear()} CampusCare · Smart Complaint Management</span>
            <span>Made for a better campus</span>
          </footer>
        </div>
      </main>
    </div>
  );
}

function StatCard({ icon, label, value, tone, detail }) {
  return (
    <article className="stat-card">
      <div className="stat-card-top">
        <span className={`stat-icon tone-${tone}`}>{icon}</span>
        <span className="stat-menu">•••</span>
      </div>
      <p className="stat-label">{label}</p>
      <div className="stat-value">{value}</div>
      <p className="stat-detail">{detail}</p>
    </article>
  );
}

function ComplaintTable({ items, isAdmin, onCategoryChange, loading, emptyText }) {
  return (
    <div className="table-wrap">
      <table className="complaint-table">
        <thead>
          <tr>
            <th>Complaint</th>
            <th>Category</th>
            <th>Status</th>
            <th>Date</th>
            {isAdmin && <th>Action</th>}
          </tr>
        </thead>
        <tbody>
          {loading && items.length === 0 ? (
            <tr><td colSpan={isAdmin ? 5 : 4} className="empty-state">Loading complaints…</td></tr>
          ) : items.length === 0 ? (
            <tr><td colSpan={isAdmin ? 5 : 4} className="empty-state">{emptyText}</td></tr>
          ) : (
            items.map((item, index) => (
              <tr key={complaintId(item) === "—" ? index : complaintId(item)}>
                <td>
                  <div className="complaint-cell">
                    <span className="complaint-symbol">#</span>
                    <div>
                      <strong>{complaintTitle(item)}</strong>
                      <span className="complaint-id">ID: {complaintId(item)}</span>
                      {isAdmin && item.email && <span className="complaint-id">{item.email}</span>}
                    </div>
                  </div>
                </td>
                <td>
                  {isAdmin ? (
                    <select
                      className="category-select"
                      value={complaintCategory(item)}
                      onChange={(event) => onCategoryChange(item, event.target.value)}
                      aria-label={`Change category for complaint ${complaintId(item)}`}
                    >
                      {!CATEGORY_OPTIONS.includes(complaintCategory(item)) && (
                        <option value={complaintCategory(item)}>{complaintCategory(item)}</option>
                      )}
                      {CATEGORY_OPTIONS.map((category) => (
                        <option value={category} key={category}>{category}</option>
                      ))}
                    </select>
                  ) : (
                    <span className="category-text">{complaintCategory(item)}</span>
                  )}
                </td>
                <td><StatusBadge status={complaintStatus(item)} /></td>
                <td className="date-cell">{displayDate(item.createdAt ?? item.created_at ?? item.submittedAt ?? item.date)}</td>
                {isAdmin && <td><span className="admin-action-label">Manage category</span></td>}
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>
  );
}
